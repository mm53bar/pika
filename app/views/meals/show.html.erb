<% content_for :title, @meal.display_name %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <p class="text-sm text-stone-500"><%= @meal.meal_type.humanize %></p>
    <h1 class="text-2xl font-semibold tracking-tight"><%= @meal.display_name %></h1>
  </div>
  <div class="flex gap-2">
    <%= link_to "Edit", edit_meal_path(@meal), class: button_classes(:secondary) %>
    <%= button_to "Delete", @meal, method: :delete, class: button_classes(:danger), data: { turbo_confirm: "Delete #{@meal.name}?" } %>
  </div>
</div>

<dl class="grid gap-4 rounded-md border border-stone-200 bg-white p-5 text-sm sm:grid-cols-4">
  <div><dt class="text-stone-500">Calories</dt><dd class="text-lg font-semibold"><%= @meal.calories || "—" %></dd></div>
  <div><dt class="text-stone-500">Weight</dt><dd class="text-lg font-semibold"><%= weight(@meal.weight_grams) %></dd></div>
  <div><dt class="text-stone-500">kcal / 100 g</dt><dd class="text-lg font-semibold"><%= @meal.calories_per_100g || "—" %></dd></div>
  <div><dt class="text-stone-500">Rating</dt><dd class="text-lg font-semibold"><%= @meal.rating ? "★" * @meal.rating : "unrated" %></dd></div>
</dl>

<% if @meal.notes.present? %>
  <div class="mt-6 whitespace-pre-line text-sm text-stone-700"><%= @meal.notes %></div>
<% end %>
