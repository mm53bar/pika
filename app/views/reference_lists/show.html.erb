<% content_for :title, @reference_list.name %>
<% weight_summary = @reference_list.weight %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight"><%= @reference_list.name %></h1>
    <p class="text-sm text-stone-500">
      <% if @reference_list.author.present? %>by <%= @reference_list.author %><% end %>
      <% if (url = @reference_list.safe_source_url) %>· <%= link_to "source", url, target: "_blank", rel: "noopener", class: "hover:text-teal-800 underline" %><% end %>
    </p>
  </div>
  <div class="flex gap-2">
    <%= link_to "Edit", edit_reference_list_path(@reference_list), class: button_classes(:secondary) %>
    <%= button_to "Delete", @reference_list, method: :delete, class: button_classes(:danger), data: { turbo_confirm: "Delete #{@reference_list.name}?" } %>
  </div>
</div>

<%= render "shared/weight_summary", weight: weight_summary %>

<% @reference_list.reference_items.group_by(&:category).each do |category, items| %>
  <section class="mt-8">
    <div class="mb-2 flex items-baseline justify-between border-b border-stone-200 pb-1">
      <h2 class="font-semibold text-stone-700"><%= category %></h2>
      <span class="text-sm text-stone-500"><%= weight(weight_summary.by_category[category]) %></span>
    </div>
    <table class="w-full text-sm">
      <tbody>
        <% items.each do |ref| %>
          <tr id="<%= dom_id(ref) %>" class="border-b border-stone-100 last:border-0">
            <td class="py-2 pr-3">
              <span class="font-medium"><%= ref.name %></span>
              <% if ref.manufacturer.present? %><span class="text-stone-500"><%= ref.manufacturer %></span><% end %>
              <% if ref.worn? %><%= badge("worn", :worn) %><% end %>
              <% if ref.consumable? %><%= badge("consumable", :consumable) %><% end %>
              <% if ref.quantity > 1 %><span class="text-stone-500">× <%= ref.quantity %></span><% end %>
            </td>
            <td class="whitespace-nowrap py-2 text-right tabular-nums"><%= weight(ref.line_weight_grams) %></td>
            <td class="py-2 pl-3 text-right">
              <%= button_to "Remove", ref, method: :delete, class: "text-xs text-red-700 hover:underline cursor-pointer" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<%= form_with model: [ @reference_list, ReferenceItem.new ], class: "mt-8 grid gap-3 rounded-md border border-stone-200 bg-white p-4 sm:grid-cols-6" do |form| %>
  <div class="sm:col-span-2">
    <%= form.label :name, "Add an item", class: label_classes %>
    <%= form.text_field :name, required: true, class: field_classes %>
  </div>
  <div>
    <%= form.label :manufacturer, class: label_classes %>
    <%= form.text_field :manufacturer, class: field_classes %>
  </div>
  <div>
    <%= form.label :category, class: label_classes %>
    <%= form.text_field :category, required: true, list: "item-categories", class: field_classes %>
    <datalist id="item-categories">
      <% Item.categories.each do |category| %><option value="<%= category %>"><% end %>
    </datalist>
  </div>
  <div>
    <%= form.label :weight_grams, "Weight (g)", class: label_classes %>
    <%= form.number_field :weight_grams, min: 0, class: field_classes %>
  </div>
  <div>
    <%= form.label :quantity, "Qty", class: label_classes %>
    <%= form.number_field :quantity, value: 1, min: 1, class: field_classes %>
  </div>
  <div class="flex items-center gap-4 text-sm sm:col-span-4">
    <label class="flex items-center gap-2"><%= form.check_box :worn %> worn</label>
    <label class="flex items-center gap-2"><%= form.check_box :consumable %> consumable</label>
  </div>
  <div class="sm:col-span-2 sm:text-right"><%= form.submit "Add", class: button_classes %></div>
<% end %>
