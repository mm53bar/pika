<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
  <% [ [ "Base", weight.base_grams ], [ "Worn", weight.worn_grams ],
       [ "Consumables", weight.consumable_grams ], [ "Total", weight.total_grams ] ].each do |label, grams| %>
    <div class="rounded-md border border-stone-200 bg-white px-4 py-3">
      <p class="text-xs uppercase tracking-wide text-stone-500"><%= label %></p>
      <p class="text-lg font-semibold <%= label == "Base" ? "text-teal-800" : "text-stone-800" %>"><%= weight(grams) %></p>
    </div>
  <% end %>
</div>
