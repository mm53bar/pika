<% content_for :title, @item.name %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <p class="text-sm text-stone-500"><%= @item.category %></p>
    <h1 class="text-2xl font-semibold tracking-tight"><%= @item.display_name %></h1>
    <div class="mt-2"><%= item_badges(@item) %></div>
  </div>
  <div class="flex gap-2">
    <%= link_to "Edit", edit_item_path(@item), class: button_classes(:secondary) %>
    <%= button_to "Delete", @item, method: :delete, class: button_classes(:danger),
          data: { turbo_confirm: "Delete #{@item.name}? It comes off every trip and kit too." } %>
  </div>
</div>

<dl class="grid gap-4 rounded-md border border-stone-200 bg-white p-5 text-sm sm:grid-cols-3">
  <div>
    <dt class="text-stone-500">Weight used</dt>
    <dd class="text-lg font-semibold"><%= @item.per_unit? ? "#{weight(@item.unit_weight_grams)} per #{@item.unit_label.presence || "unit"}" : weight(@item.effective_weight_grams) %></dd>
  </div>
  <div>
    <dt class="text-stone-500">Listed</dt>
    <dd><%= weight(@item.weight_grams) %></dd>
  </div>
  <div>
    <dt class="text-stone-500">Weighed</dt>
    <dd><%= weight(@item.measured_weight_grams) %></dd>
  </div>
</dl>

<% if @item.purchased_on || @item.inbound_email %>
  <p class="mt-4 text-sm text-stone-600">
    Bought <%= @item.purchased_on&.to_fs(:long) %>
    <% if @item.inbound_email %>· <%= link_to "order email", @item.inbound_email, class: "underline hover:text-teal-800" %><% end %>
  </p>
<% end %>

<% if @item.notes.present? %>
  <div class="mt-6 whitespace-pre-line text-sm text-stone-700"><%= @item.notes %></div>
<% end %>

<section class="mt-8">
  <h2 class="mb-2 font-semibold text-stone-700">Trips</h2>
  <% if @trips.any? %>
    <ul class="space-y-1 text-sm">
      <% @trips.each do |trip| %>
        <li><%= link_to trip.name, trip, class: "hover:text-teal-800" %> <span class="text-stone-500"><%= trip.starts_on&.to_fs(:long) %></span></li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-stone-500">Not packed for any trip yet.</p>
  <% end %>
</section>
