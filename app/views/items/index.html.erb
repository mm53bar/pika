<% content_for :title, "Gear" %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-semibold tracking-tight">Gear</h1>
  <%= link_to "Add gear", new_item_path, class: button_classes %>
</div>

<nav class="mb-6 flex flex-wrap gap-x-4 gap-y-1 text-sm">
  <% Item::STATUSES.each do |status| %>
    <%= link_to status.humanize, items_path(status: status),
          class: (status == @status && !@retired) ? "font-medium text-teal-800 underline underline-offset-4" : "text-stone-600 hover:text-teal-800" %>
  <% end %>
  <%= link_to "Retired", items_path(retired: 1),
        class: @retired ? "font-medium text-teal-800 underline underline-offset-4" : "text-stone-600 hover:text-teal-800" %>
</nav>

<% if @items.empty? %>
  <p class="text-stone-500">Nothing here yet.</p>
<% else %>
  <% @items.group_by(&:category).each do |category, items| %>
    <section class="mb-8">
      <div class="mb-2 flex items-baseline justify-between border-b border-stone-200 pb-1">
        <h2 class="font-semibold text-stone-700"><%= category %></h2>
        <span class="text-sm text-stone-500"><%= weight(items.sum { |item| item.weight_for(1) }) %></span>
      </div>
      <table class="w-full text-sm">
        <tbody>
          <% items.each do |item| %>
            <tr id="<%= dom_id(item) %>" class="border-b border-stone-100 last:border-0">
              <td class="py-2 pr-3">
                <%= link_to item.name, item, class: "font-medium hover:text-teal-800" %>
                <% if item.manufacturer.present? %><span class="text-stone-500"><%= item.manufacturer %></span><% end %>
                <%= item_badges(item) %>
              </td>
              <td class="whitespace-nowrap py-2 text-right tabular-nums">
                <%= item.unweighed? ? tag.span("unweighed", class: "text-stone-400") : weight(item.weight_for(1)) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>
<% end %>
