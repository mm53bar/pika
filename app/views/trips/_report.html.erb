<%# A past trip leads with this: how it went, and how each piece of gear did. %>
<section class="mt-8 rounded-md border border-teal-200 bg-white p-5">
  <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-lg font-semibold text-stone-800">Trip report</h2>
    <span class="text-sm text-stone-500">
      <%= trip.reported? ? "Filed #{trip.reported_on.to_fs(:long)}" : "How did it go?" %>
    </span>
  </div>

  <%= form_with url: report_trip_path(trip), method: :patch, class: "space-y-6" do |form| %>
    <div class="grid gap-5 sm:grid-cols-3">
      <% { report: [ "How it went", "Weather, conditions, the route, anything worth remembering." ],
           worked_well: [ "What worked well", "Gear, food, planning — keep doing this." ],
           didnt_work: [ "What didn't", "Missing, wrong, too heavy, never used." ] }.each do |field, (label, hint)| %>
        <div>
          <%= label_tag "trip_#{field}", label, class: label_classes %>
          <%= text_area_tag "trip[#{field}]", trip.public_send(field), rows: 5, id: "trip_#{field}", placeholder: hint, class: field_classes %>
        </div>
      <% end %>
    </div>

    <% if trip.trip_items.any? %>
      <div>
        <h3 class="mb-1 font-semibold text-stone-700">How the gear did</h3>
        <p class="mb-3 text-sm text-stone-500">Rate what you want to remember; leave the rest blank.</p>
        <% trip.trip_items.group_by(&:category).each do |category, lines| %>
          <p class="mt-4 border-b border-stone-200 pb-1 text-sm font-medium text-stone-600"><%= category %></p>
          <% lines.each do |line| %>
            <div id="<%= dom_id(line, :review) %>" class="grid items-center gap-2 border-b border-stone-100 py-2 sm:grid-cols-12">
              <%= label_tag "lines_#{line.id}_rating", line.item.display_name, class: "text-sm sm:col-span-4" %>
              <%= select_tag "lines[#{line.id}][rating]",
                    options_for_select([ [ "Not rated", "" ] ] + (1..5).map { |r| [ "★" * r, r ] }, line.rating),
                    id: "lines_#{line.id}_rating", class: "rounded border border-stone-300 px-2 py-1 text-sm sm:col-span-2" %>
              <%= text_field_tag "lines[#{line.id}][review]", line.review, placeholder: "How it did on this trip",
                    aria: { label: "Note on #{line.item.display_name}" }, class: "rounded border border-stone-300 px-2 py-1 text-sm sm:col-span-6" %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%= form.submit trip.reported? ? "Update trip report" : "Save trip report", class: button_classes %>
  <% end %>
</section>
