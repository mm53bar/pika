<% content_for :title, "API" %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-semibold tracking-tight">API</h1>
  <div class="flex gap-2 text-sm">
    <%= link_to "Markdown", docs_api_path(format: :md), class: button_classes(:secondary) %>
    <%= link_to "llms.txt", llms_txt_path, class: button_classes(:secondary) %>
    <%= link_to "API catalog", api_catalog_path, class: button_classes(:secondary) %>
  </div>
</div>

<pre class="overflow-x-auto whitespace-pre-wrap rounded-md border border-stone-200 bg-white p-5 font-mono text-sm leading-relaxed text-stone-800"><%= @markdown %></pre>
