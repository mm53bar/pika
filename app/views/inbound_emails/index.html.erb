<% content_for :title, "Inbox" %>

<div class="mb-2 flex items-center justify-between">
  <h1 class="text-2xl font-semibold tracking-tight">Inbox</h1>
  <%= link_to "Retailers", retailers_path, class: button_classes(:secondary) %>
</div>
<p class="mb-6 text-sm text-stone-500">Purchase emails forwarded to the shared inbox. Review what was bought, then add it to your gear.</p>

<% if @waiting.empty? %>
  <p class="rounded-md border border-stone-200 bg-white px-4 py-6 text-center text-stone-500">Nothing waiting.</p>
<% else %>
  <ul class="divide-y divide-stone-200 rounded-md border border-stone-200 bg-white">
    <% @waiting.each do |email| %>
      <li id="<%= dom_id(email) %>" class="flex flex-wrap items-baseline justify-between gap-2 px-4 py-3">
        <div>
          <%= link_to email.subject.presence || "(no subject)", email, class: "font-medium hover:text-teal-800" %>
          <p class="text-sm text-stone-500">
            <%= email.retailer || email.from_address %>
            · <%= email.proposal.any? ? pluralize(email.proposal.size, "item") : "couldn't be read" %>
          </p>
        </div>
        <span class="text-sm text-stone-500"><%= email.received_at.to_date.to_fs(:long) %></span>
      </li>
    <% end %>
  </ul>
<% end %>

<% if @recent.any? %>
  <h2 class="mb-2 mt-10 font-semibold text-stone-700">Recently handled</h2>
  <ul class="space-y-1 text-sm">
    <% @recent.each do |email| %>
      <li>
        <%= link_to email.subject.presence || "(no subject)", email, class: "hover:text-teal-800" %>
        <%= badge(email.status.humanize) %>
        <span class="text-stone-500"><%= email.received_at.to_date.to_fs(:long) %></span>
      </li>
    <% end %>
  </ul>
<% end %>
